# Copy to .env and fill in. server.py reads it at startup (shell variables win).

# API key created in the OmniRoute dashboard (http://localhost:20128).
OMNIROUTE_API_KEY=

# Free models tried in order (comma-separated); a model that fails sits out 1 minute.
OMNIROUTE_MODELS=openrouter/openrouter/free,cfp/openai/gpt-oss-120b,ddgw/gpt-5.4-mini,auto/best-free

# OmniRoute endpoint (OpenAI-compatible).
OMNIROUTE_URL=http://localhost:20128/v1
